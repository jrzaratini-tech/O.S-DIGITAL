rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && userDoc().ativo == true;
    }

    function fullAccess() {
      return activeUser() && userDoc().perfil in ['comercial', 'projetista'];
    }

    function mountingAccess() {
      return activeUser() && userDoc().perfil == 'montagem';
    }

    function fixedAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'greicesantana@icloud.com',
          'jrzaratini@icloud.com'
        ];
    }

    function validMountingInvite(inviteId) {
      return exists(/databases/$(database)/documents/convites/$(inviteId))
        && get(/databases/$(database)/documents/convites/$(inviteId)).data.perfil == 'montagem'
        && get(/databases/$(database)/documents/convites/$(inviteId)).data.ativo != false;
    }

    function unclaimedInvite(inviteId) {
      return !get(/databases/$(database)/documents/convites/$(inviteId)).data.keys().hasAny(['claimedUid'])
        || get(/databases/$(database)/documents/convites/$(inviteId)).data.claimedUid == '';
    }

    function claimableByCurrentUser(inviteId) {
      return validMountingInvite(inviteId)
        && (
          unclaimedInvite(inviteId)
          || get(/databases/$(database)/documents/convites/$(inviteId)).data.claimedUid == request.auth.uid
        );
    }

    function ownsInvite(inviteId) {
      return mountingAccess() && userDoc().inviteId == inviteId;
    }

    function assignedToMountingUser() {
      return mountingAccess()
        && (
          resource.data.assignedMountingUid == request.auth.uid
          || resource.data.assignedMountingToken == userDoc().inviteId
        );
    }

    function keepsMountingAssignment() {
      return request.resource.data.assignedMountingUid == resource.data.assignedMountingUid
        && request.resource.data.assignedMountingToken == resource.data.assignedMountingToken
        && request.resource.data.assignedMountingName == resource.data.assignedMountingName;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || fullAccess());

      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          fixedAdminEmail()
          || (
            request.resource.data.perfil == 'montagem'
            && request.resource.data.ativo == true
            && request.resource.data.keys().hasAll(['inviteId', 'nome', 'email'])
            && claimableByCurrentUser(request.resource.data.inviteId)
            && request.resource.data.nome == get(/databases/$(database)/documents/convites/$(request.resource.data.inviteId)).data.nome
            && request.resource.data.email is string
          )
        );

      allow update, delete: if fullAccess();
    }

    match /convites/{inviteId} {
      allow get: if true;
      allow list, create, delete: if fullAccess();

      allow update: if fullAccess()
        || (
          signedIn()
          && resource.data.perfil == 'montagem'
          && resource.data.ativo != false
          && (
            !resource.data.keys().hasAny(['claimedUid'])
            || resource.data.claimedUid == ''
            || resource.data.claimedUid == request.auth.uid
          )
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['claimedUid', 'claimedEmail', 'claimedAt', 'used'])
          && request.resource.data.claimedUid == request.auth.uid
          && request.resource.data.claimedEmail is string
          && request.resource.data.used == true
        );

      match /servicos/{serviceId} {
        allow read: if fullAccess() || ownsInvite(inviteId);

        allow create, delete: if fullAccess();

        allow update: if fullAccess()
          || (
            ownsInvite(inviteId)
            && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['mounting', 'updatedAt'])
          );
      }
    }

    match /servicos/{serviceId} {
      allow read: if fullAccess()
        || assignedToMountingUser();

      allow create, delete: if fullAccess();

      allow update: if fullAccess()
        || (
          assignedToMountingUser()
          && keepsMountingAssignment()
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['mounting', 'updatedAt'])
        );
    }
  }
}
