rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && userDoc().ativo == true;
    }

    function fullAccess() {
      return activeUser() && userDoc().perfil in ['comercial', 'projetista'];
    }

    function mountingAccess() {
      return activeUser() && userDoc().perfil == 'montagem';
    }

    function fixedAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'greicesantana@icloud.com',
          'jrzaratini@icloud.com'
        ];
    }

    function adminAccess() {
      return fullAccess() || fixedAdminEmail();
    }

    function ownsInvite(inviteId) {
      return mountingAccess() && userDoc().inviteId == inviteId;
    }

    function assignedToMountingUser() {
      return mountingAccess()
        && (
          resource.data.assignedMountingUid == request.auth.uid
          || resource.data.assignedMountingToken == userDoc().inviteId
        );
    }

    function keepsMountingAssignment() {
      return request.resource.data.assignedMountingUid == resource.data.assignedMountingUid
        && request.resource.data.assignedMountingToken == resource.data.assignedMountingToken
        && request.resource.data.assignedMountingName == resource.data.assignedMountingName;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || adminAccess());

      allow create: if signedIn()
        && (
          adminAccess()
          || (
            request.auth.uid == uid
            && fixedAdminEmail()
          )
          || (
            request.auth.uid == uid
            && request.resource.data.perfil == 'montagem'
            && request.resource.data.ativo == true
            && request.resource.data.inviteId == request.auth.uid
          )
        );

      allow update, delete: if adminAccess();
    }

    match /convites/{inviteId} {
      allow get: if adminAccess() || ownsInvite(inviteId);
      allow list, create, update, delete: if adminAccess();

      match /servicos/{serviceId} {
        allow read: if adminAccess() || ownsInvite(inviteId);
        allow create, delete: if adminAccess();

        allow update: if adminAccess()
          || (
            ownsInvite(inviteId)
            && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['mounting', 'updatedAt'])
          );
      }
    }

    match /servicos/{serviceId} {
      allow read: if adminAccess() || assignedToMountingUser();
      allow create, delete: if adminAccess();

      allow update: if adminAccess()
        || (
          assignedToMountingUser()
          && keepsMountingAssignment()
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['mounting', 'updatedAt'])
        );
    }
  }
}
