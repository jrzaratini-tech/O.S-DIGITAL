rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && userDoc().ativo == true;
    }

    function fullAccess() {
      return activeUser() && userDoc().perfil in ['comercial', 'projetista'];
    }

    function mountingAccess() {
      return activeUser() && userDoc().perfil == 'montagem';
    }

    function fixedAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'greicesantana@icloud.com',
          'jrzaratini@icloud.com'
        ];
    }

    function hasPanelToken() {
      return (
          resource.data.keys().hasAll(['assignedMountingToken'])
          && resource.data.assignedMountingToken != ''
        )
        || (
          resource.data.keys().hasAll(['assignedMountingUid'])
          && resource.data.assignedMountingUid != ''
        )
        || (
          resource.data.keys().hasAll(['assignedMountingName'])
          && resource.data.assignedMountingName != ''
        );
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || fullAccess());

      allow create: if signedIn()
        && request.auth.uid == uid
        && fixedAdminEmail();

      allow update, delete: if fullAccess();
    }

    match /convites/{inviteId} {
      allow get: if true;
      allow list, create, update, delete: if fullAccess();

      match /servicos/{serviceId} {
        allow read: if get(/databases/$(database)/documents/convites/$(inviteId)).data.perfil == 'montagem'
          && get(/databases/$(database)/documents/convites/$(inviteId)).data.ativo != false;

        allow create, delete: if fullAccess();

        allow update: if fullAccess()
          || (
            !signedIn()
            && get(/databases/$(database)/documents/convites/$(inviteId)).data.perfil == 'montagem'
            && get(/databases/$(database)/documents/convites/$(inviteId)).data.ativo != false
            && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['mounting', 'updatedAt'])
          );
      }
    }

    match /servicos/{serviceId} {
      allow read: if fullAccess()
        || (mountingAccess() && resource.data.assignedMountingUid == request.auth.uid)
        || (!signedIn() && hasPanelToken());

      allow create, delete: if fullAccess();

      allow update: if fullAccess()
        || (
          mountingAccess()
          && resource.data.assignedMountingUid == request.auth.uid
          && request.resource.data.assignedMountingUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['mounting', 'updatedAt'])
        )
        || (
          !signedIn()
          && hasPanelToken()
          && (
            request.resource.data.assignedMountingToken == resource.data.assignedMountingToken
            || request.resource.data.assignedMountingUid == resource.data.assignedMountingUid
            || request.resource.data.assignedMountingName == resource.data.assignedMountingName
          )
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['mounting', 'updatedAt'])
        );
    }
  }
}
